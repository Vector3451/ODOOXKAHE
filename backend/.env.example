# ── Traveloop Backend — Environment Variables ─────────────────────────────
# Copy this file to .env and fill in your values.
# .env is git-ignored and must NEVER be committed.

# Flask secret key for JWT signing — generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-me-use-a-long-random-string

# Database URL
# SQLite (default — zero-setup, file lives next to app.py):
DATABASE_URL=sqlite:///dev.db
# MySQL/Postgres (production):
# DATABASE_URL=mysql+pymysql://user:pass@host:3306/trip_planner
# DATABASE_URL=postgresql://user:pass@host:5432/trip_planner

# Flask environment
FLASK_ENV=development
FLASK_DEBUG=1

# Allowed CORS origins (comma-separated)
# Leave blank to allow all origins (dev only)
CORS_ORIGINS=http://localhost:5173,http://localhost:8080,http://localhost:8081,http://localhost:8082,http://127.0.0.1:5173
